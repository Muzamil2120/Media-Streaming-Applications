{
  "name": "mern-mediastream-server",
  "version": "1.0.0",
  "description": "Media Streaming Application",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "development": "nodemon server/server.js",
    "build": "echo 'Build script not configured'",
    "build-vercel": "cd client && npm ci --omit=dev && npm run build",
    "build-versel": "npm run build-vercel",
    "start:prod": "node server/server.js",
    "start:dev": "concurrently \"npm run dev\" \"cd client && npm start\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "formidable": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "mongoose": "^7.8.8",
    "multer": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "babel-core": "^6.26.2",
    "babel-loader": "^7.1.4",
    "babel-preset-env": "^1.6.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-2": "^6.24.1",
    "concurrently": "^9.2.1",
    "nodemon": "^1.19.4",
    "webpack": "^4.6.0",
    "webpack-dev-middleware": "^3.1.2",
    "webpack-hot-middleware": "^2.22.1",
    "webpack-node-externals": "^1.7.2"
  },
  "keywords": [],
