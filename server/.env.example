MONGODB_URI=mongodb://127.0.0.1:27017/mediastream
PORT=5001

# If you use MongoDB Atlas, set your connection string here, e.g.: 
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mediastream?retryWrites=true&w=majority
PORT=5001
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.sawvpij.mongodb.net/mediastream?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

